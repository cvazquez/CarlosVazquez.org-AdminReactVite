{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["react", "import", "jsx-a11y", "typescript", "oxc"],
    "categories": {
        "correctness": "error"
    },
    "env": {
        "browser": true,
        "node": true,
        "es2022": true
    },
    "settings": {
        "react": {
            "version": "19.2.8"
        }
    },
    "rules": {
        "no-console": "error",
        "max-params": ["error", 7],
        "typescript/no-unused-vars": [
            "error",
            {
                "args": "after-used",
                "ignoreRestSiblings": false
            }
        ],
        "react/rules-of-hooks": "error",
        "react/only-export-components": ["warn", { "allowConstantExport": true }]
    }
}
